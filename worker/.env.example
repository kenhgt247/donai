# Đổi tên thành .env (cùng thư mục với docker-compose.yml)

# 🔑 Supabase — Project Settings → API Keys (dùng key service_role / secret, TUYỆT MẬT)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 🔑 VieNeu-TTS — nếu chạy trên cùng VPS thì để như dưới
VIENEU_API_URL=http://host.docker.internal:8000
VIENEU_API_KEY=
VIENEU_MODEL=vieneu-v3-turbo
VIENEU_SAMPLE_RATE=48000

# Tuỳ chọn
POLL_MS=3000          # bao lâu kiểm tra hàng đợi một lần (mili giây)
