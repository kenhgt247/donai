# =====================================================================
# Đổi tên file này thành .env.local rồi điền giá trị thật.
# .env.local KHÔNG được đưa lên GitHub (Next.js đã chặn sẵn trong .gitignore).
# Khi deploy lên Cloudflare: Worker "donai" → Settings → Variables and Secrets, nhập lại y hệt.
# 5 biến NEXT_PUBLIC_... nhập THÊM vào Settings → Build → Build variables.
# =====================================================================

# 🔑 SUPABASE — Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dien-anon-hoac-publishable-key
SUPABASE_SERVICE_ROLE_KEY=dien-service-role-hoac-secret-key   # TUYỆT MẬT

# 🔑 CLAUDE API — console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# 🔑 VIENEU-TTS — máy chủ bạn tự chạy (Docker)
VIENEU_API_URL=https://tts.ten-mien-cua-ban.com   # không có dấu / ở cuối; chạy thử trên máy: http://localhost:8000
VIENEU_API_KEY=                                   # token bạn tự đặt cho lớp bảo vệ; để trống nếu chạy thử trên máy
VIENEU_MODEL=vieneu-v3-turbo
VIENEU_SAMPLE_RATE=48000

# 🔑 SEPAY — webhook nạp tiền (my.sepay.vn → WebHooks → Thêm webhook)
SEPAY_WEBHOOK_API_KEY=tu-dat-mot-chuoi-ngau-nhien-dai   # nhập Y HỆT vào ô "API Key" trên SePay
SEPAY_ACCOUNT_NUMBER=0123456789                          # số tài khoản nhận tiền của bạn

# 🏦 Tài khoản nhận tiền (hiện mã QR VietQR ở trang Nạp Credit)
NEXT_PUBLIC_BANK_ID=MB                      # mã ngân hàng: MB, VCB, TCB, ACB, BIDV...
NEXT_PUBLIC_BANK_ACCOUNT_NO=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=NGUYEN VAN A  # tên chủ tài khoản, viết hoa không dấu
